# .env.example - Template for environment variables
# Copy this file to .env and fill in your actual values.

# MongoDB Atlas connection string (replace <username>, <password>, <cluster>, <db>)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Next.js public API keys (prefixed with NEXT_PUBLIC_ to be exposed to the browser)
NEXT_PUBLIC_EMAIL_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAIL_PUBLIC_KEY=your_public_key_here

# Server configuration
PORT=3000
NODE_ENV=development
